import pandas as pd
import os
from pathlib import Path

def generate_excel():
    # Cria pasta se não existir
    excel_dir = Path('scripts/excel')
    excel_dir.mkdir(parents=True, exist_ok=True)
    
    # Lista todos os CSVs
    data_dir = Path('data')
    all_data = []
    
    for csv_file in data_dir.glob('*.csv'):
        try:
            df = pd.read_csv(csv_file)
            df['indicator'] = csv_file.stem  # Nome do arquivo sem extensão
            all_data.append(df)
            print(f"Processado: {csv_file.name}")
        except Exception as e:
            print(f"Erro ao processar {csv_file.name}: {e}")
    
    if all_data:
        # Combina todos os dados
        combined_df = pd.concat(all_data, ignore_index=True)
        
        # Salva como Excel
        excel_path = excel_dir / 'sdg-data.xlsx'
        combined_df.to_excel(excel_path, index=False)
        
        print(f"Excel gerado: {excel_path}")
        print(f"Total de linhas: {len(combined_df)}")
    else:
        print("Nenhum dado encontrado!")

if __name__ == "__main__":
    generate_excel()
